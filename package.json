{
  "name": "vislet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "check": "astro check",
    "dev": "astro dev",
    "preview": "astro preview",
    "format": "prettier --write \"{src,__tests__,scripts}/**/*.{ts,tsx,js,css,md,astro}\"",
    "format:check": "prettier --list-different \"{src,__tests__,scripts}/**/*.{ts,tsx,js,css,md,astro}\"",
    "knip": "knip",
    "lint": "eslint . --ext .ts,.tsx,.astro --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx,.astro --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "data:build": "tsx scripts/etl/build.ts",
    "data:build:brooklyn": "tsx scripts/etl/brooklyn/build.ts",
    "data:build:311": "tsx scripts/etl/311/build.ts",
    "data:build:chicago": "tsx scripts/etl/chicago/build.ts",
    "data:build:north-carolina": "tsx scripts/etl/north-carolina/build.ts"
  },
  "dependencies": {
    "@astrojs/react": "5.0.7",
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.0",
    "astro": "6.4.4",
    "clsx": "2.1.1",
    "d3": "7.9.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/d3": "7.4.3",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "5.1.4",
    "@vitest/coverage-istanbul": "4.1.8",
    "eslint": "10.4.1",
    "eslint-plugin-astro": "1.7.0",
    "jsdom": "29.1.1",
    "knip": "6.16.1",
    "postcss": "8.5.15",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.8"
  },
  "overrides": {
    "minimatch": ">=10.2.1",
    "lodash": ">=4.17.22"
  },
  "engines": {
    "node": "24.x"
  }
}
