{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": ["src/pages/**/*.{ts,astro}", "src/layouts/**/*.astro", "scripts/etl/**/build.ts"],
  "project": ["src/**/*.{ts,tsx,astro}", "scripts/**/*.ts", "__tests__/**/*.{ts,tsx}"],
  "ignore": ["src/types/index.ts"],
  "ignoreDependencies": [
    "tailwindcss",
    "topojson-client",
    "@types/topojson-client",
    "@testing-library/dom",
    "@testing-library/react"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "astro": {
    "entry": ["astro.config.{js,ts,mjs}", "src/pages/**/*.astro", "src/layouts/**/*.astro"]
  },
  "vitest": {
    "entry": ["vitest.config.{js,ts}", "__tests__/**/*.{test,spec}.{ts,tsx}"]
  },
  "eslint": {
    "entry": ["eslint.config.{js,mjs}"]
  },
  "postcss": {
    "entry": ["postcss.config.{js,mjs}"]
  }
}
